# Hugging Face sequence-classification model used as the prototype text stage.
# Swap this later for an in-house fine-tuned model without changing the API.
HF_MODEL_ID=mariagrandury/distilbert-base-uncased-finetuned-sms-spam-detection

# Messages with fraud_probability >= this value are labeled FRAUD.
FRAUD_THRESHOLD=0.5

# Reject request bodies longer than this many characters.
MAX_TEXT_LENGTH=2000

# Tokenizer truncation length (tokens).
MAX_TOKENS=256
